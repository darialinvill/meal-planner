# Server
PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string

# Postgres connection string.
#  - Local dev: postgres://user:pass@localhost:5432/nourish
#  - Railway: provided automatically as DATABASE_URL when you attach a Postgres plugin
DATABASE_URL=postgres://localhost:5432/nourish

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Resend (email)
RESEND_API_KEY=re_...
EMAIL_FROM=Nourish <nourish@yourdomain.com>

# Public URL of the deployed app — used in the weekly vote email.
APP_URL=http://localhost:5173

# Cron toggle (set to "false" to disable the Sunday auto-generate)
CRON_ENABLED=true

# Set NODE_ENV=production on Railway. Locally, leave unset.
# NODE_ENV=production
