# Server
PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data/nourish.sqlite

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Resend (email)
RESEND_API_KEY=re_...
EMAIL_FROM=Nourish <nourish@yourdomain.com>

# Cron toggle (set to "false" to disable Sunday auto-generate)
CRON_ENABLED=true

# Client (only needed if you split deployment; defaults to same-origin in dev via Vite proxy)
# VITE_API_BASE=http://localhost:4000
